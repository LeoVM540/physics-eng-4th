\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}[2026/10/16 Nanotechnology notes preamble]

% ---------- Page and fonts ----------
\RequirePackage[a4paper,margin=2.2cm,headheight=14pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage[english]{babel}

% ---------- Maths and units ----------
\RequirePackage{amsmath,amssymb}
\RequirePackage{siunitx}
\sisetup{detect-all, range-phrase = {\text{--}}, separate-uncertainty = true}
\RequirePackage{mhchem}

% ---------- Tables, lists, figures ----------
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{makecell}
\RequirePackage[table]{xcolor}
\RequirePackage{enumitem}
\setlist{nosep, leftmargin=*}
\RequirePackage{graphicx}
\graphicspath{{figures/}}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,calc}
\RequirePackage{caption}
\RequirePackage{pdflscape}
\captionsetup{font=small, labelfont=bf}

% ---------- Header ----------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\nouppercase{\leftmark}}
\fancyhead[R]{\small Nanotechnology}
\fancyfoot[C]{\thepage}

% ---------- Colours ----------
\definecolor{defc}{HTML}{1F5FA8}
\definecolor{keyc}{HTML}{6A3D9A}
\definecolor{proc}{HTML}{2E7D32}
\definecolor{conc}{HTML}{C62828}
\definecolor{tipc}{HTML}{E08E0B}
\definecolor{pitc}{HTML}{B71C1C}
\definecolor{classc}{HTML}{00838F}
\definecolor{recc}{HTML}{37474F}

% ---------- Boxes ----------
\RequirePackage[most]{tcolorbox}
\tcbset{
  nanobase/.style={enhanced, breakable, boxrule=0.6pt, arc=2pt,
    left=5pt, right=5pt, top=3pt, bottom=3pt, fonttitle=\bfseries\small,
    before skip=6pt, after skip=6pt}
}
% Definition
\newtcolorbox{defbox}[1][]{nanobase, colback=defc!5, colframe=defc, title={Definition#1}}
% Key equation / key result
\newtcolorbox{keybox}[1][]{nanobase, colback=keyc!5, colframe=keyc, title={Key result#1}}
% Method card (synthesis method or technique summary)
\newtcolorbox{cardbox}[1]{nanobase, colback=recc!3, colframe=recc, title={#1}}
% Exam tip
\newtcolorbox{tipbox}[1][]{nanobase, colback=tipc!7, colframe=tipc, title={Exam tip#1}}
% Pitfall / common mistake
\newtcolorbox{pitfall}[1][]{nanobase, colback=pitc!4, colframe=pitc, title={Common mistake#1}}
% Things written/said in class (handwritten notes on the slides)
\newtcolorbox{classbox}[1][]{nanobase, colback=classc!5, colframe=classc, title={From class (handwritten notes)#1}}
% Step-by-step recipe for an exercise type
\newtcolorbox{recipe}[1]{nanobase, colback=white, colframe=recc, coltitle=white, colbacktitle=recc, title={Recipe: #1}}

% Pros / cons side by side
\newcommand{\proscons}[2]{%
\par\noindent
\begin{tcbraster}[raster columns=2, raster equal height, raster column skip=4pt, raster before skip=4pt, raster after skip=6pt]
\begin{tcolorbox}[nanobase, breakable=false, colback=proc!5, colframe=proc, title={Advantages}]
#1
\end{tcolorbox}
\begin{tcolorbox}[nanobase, breakable=false, colback=conc!5, colframe=conc, title={Drawbacks}]
#2
\end{tcolorbox}
\end{tcbraster}}

% ---------- Flags ----------
% Material added that is not in the course notes
\newcommand{\extra}{\textsuperscript{\textcolor{tipc}{\textbf{(extra)}}}}
% Something in the notes that looks doubtful: keep original, flag it
\newcommand{\checkflag}[1]{\textcolor{pitc}{\textbf{[CHECK: #1]}}}
% Value read off a figure (approximate)
\newcommand{\readoff}{\textsuperscript{\textcolor{recc}{\textit{(read from figure)}}}}
% Pointer to the slide number in "Apunts Nanotechnology.pdf"
\newcommand{\slide}[1]{\textcolor{gray}{\small[slide~#1]}}

% ---------- Shortcuts ----------
\newcommand{\Ang}{\,\text{\AA}}
\newcommand{\hkl}[1]{(#1)}
\newcommand{\planefam}[1]{\{#1\}}
\newcommand{\twotheta}{2\theta}

% ---------- Links ----------
\RequirePackage[colorlinks=true, linkcolor=defc, urlcolor=defc, citecolor=defc]{hyperref}
\RequirePackage[nameinlink,capitalise]{cleveref}
\RequirePackage{bookmark}

\setcounter{tocdepth}{2}
\numberwithin{equation}{section}
